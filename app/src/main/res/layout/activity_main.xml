<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="horizontal">

    <!-- Sidebar angosto con íconos -->
    <LinearLayout android:id="@+id/sidebar"
        android:layout_width="64dp" android:layout_height="match_parent"
        android:background="@color/surface" android:orientation="vertical"
        android:gravity="center_horizontal" android:paddingVertical="16dp">

        <TextView android:layout_width="40dp" android:layout_height="40dp"
            android:text="Z" android:textColor="@color/primary"
            android:textSize="24sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginBottom="16dp"
            android:background="@color/surface2"/>

        <View android:layout_width="40dp" android:layout_height="1dp"
            android:background="@color/border" android:layout_marginBottom="8dp"/>

        <ImageButton android:id="@+id/btnTv"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_home" android:tint="@color/primary"
            android:background="@color/surface2" android:layout_marginBottom="4dp"
            android:padding="10dp" android:focusable="true"/>

        <ImageButton android:id="@+id/btnPeliculas"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_explore" android:tint="@color/text_hint"
            android:background="@color/surface" android:layout_marginBottom="4dp"
            android:padding="10dp" android:focusable="true"/>

        <ImageButton android:id="@+id/btnSeries"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_star" android:tint="@color/text_hint"
            android:background="@color/surface" android:layout_marginBottom="4dp"
            android:padding="10dp" android:focusable="true"/>

        <ImageButton android:id="@+id/btnAdultos"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_settings" android:tint="@color/text_hint"
            android:background="@color/surface" android:layout_marginBottom="4dp"
            android:padding="10dp" android:focusable="true"/>

        <View android:layout_width="0dp" android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageButton android:id="@+id/btnClearCache"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_refresh" android:tint="@color/text_hint"
            android:background="@color/surface" android:layout_marginBottom="4dp"
            android:padding="10dp" android:focusable="true"/>

        <ImageButton android:id="@+id/btnLogout"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@drawable/ic_search" android:tint="@color/error"
            android:background="@color/surface"
            android:padding="10dp" android:focusable="true"/>
    </LinearLayout>

    <View android:layout_width="2dp" android:layout_height="match_parent"
        android:background="@color/primary"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@color/surface" android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="ZENITH TV"
                android:textColor="@color/primary" android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView android:id="@+id/tvVencimiento"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>

        <FrameLayout android:id="@+id/mainContainer"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
    </LinearLayout>
</LinearLayout>
